<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
      xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<body>

<nav th:fragment="navbar" class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm border-bottom border-secondary-subtle">
    <div class="container">
        <!-- Logo / Brand -->
        <a class="navbar-brand d-flex align-items-center fw-bold" th:href="@{/master}">
            <i class="bi bi-shield-check text-primary fs-4 me-2"></i>
            <span>SGS HEIRS <span class="badge bg-primary-subtle text-primary border border-primary-subtle fs-6 ms-1">Auth</span></span>
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarContent">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" th:href="@{/master}"><i class="bi bi-house me-1"></i>Start</a>
                </li>

                <div sec:authorize="hasRole('ADMIN')">
<!--                    <li class="nav-item" sec:authorize="hasRole('ADMIN')">-->
                    <li class="nav-item">
                        <a class="nav-link text-warning" th:href="@{/admin/create-user}"><i class="bi bi-person-plus me-1"></i>User anlegen</a>
                    </li>
<!--                    <li class="nav-item" sec:authorize="hasRole('ADMIN')">-->
                    <li class="nav-item">
                        <a class="nav-link text-info" th:href="@{/admin/users}"><i class="bi bi-people me-1"></i>Benutzerliste</a>
                    </li>
<!--                    <li class="nav-item" sec:authorize="hasRole('ADMIN')">-->
<!--                    <li class="nav-item">-->
<!--                        <a class="nav-link text-warning fw-semibold" href="#" data-bs-toggle="modal" data-bs-target="#notarModal">-->
<!--                            <i class="bi bi-file-earmark-code me-1"></i>Kanzlei & Vorlagen (XML)-->
<!--                        </a>-->
<!--                    </li>-->
                </div>

                <li class="nav-item" sec:authorize="isAuthenticated()">
                    <a class="nav-link" th:href="@{/dashboard}"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link text-light opacity-75" href="#" data-bs-toggle="modal" data-bs-target="#aboutModal">
                        <i class="bi bi-info-circle me-1"></i>Über
                    </a>
                </li>
            </ul>

            <div class="d-flex align-items-center">
                <div sec:authorize="isAuthenticated()" class="d-flex align-items-center gap-3">
                    <span class="navbar-text d-flex align-items-center text-light">
                        <i class="bi bi-person-check-fill text-success fs-5 me-2"></i>
                        <span>Angemeldet: <strong sec:authentication="name" class="text-white"></strong></span>
                    </span>
                    <form th:action="@{/logout}" method="post" class="m-0">
                        <button type="submit" class="btn btn-outline-danger btn-sm shadow-sm">
                            <i class="bi bi-box-arrow-right me-1"></i>Abmelden
                        </button>
                    </form>
                </div>
                <div sec:authorize="!isAuthenticated()">
                    <span class="badge bg-secondary-subtle text-light border border-secondary px-3 py-2">
                        <i class="bi bi-shield-slash me-2 text-warning"></i>Nicht angemeldet
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- ========================================================================= -->
    <!-- GROSSER MODALER DIALOG: NOTAR-STAMMDATEN & BRIEFE (modal-xl)             -->
    <!-- ========================================================================= -->
    <div class="modal fade" id="notarModal" tabindex="-1" aria-labelledby="notarModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content bg-dark text-white border border-secondary shadow-lg">
                <div class="modal-header border-secondary">
                    <div class="d-flex align-items-center">
                        <div class="p-2 bg-warning bg-opacity-25 text-warning rounded-3 me-2 fs-4">
                            <i class="bi bi-bank2"></i>
                        </div>
                        <div>
                            <h5 class="modal-title fw-bold mb-0" id="notarModalLabel">Kanzlei-Stammdaten & Briefvorlagen</h5>
                            <small class="text-secondary">Wird in <code>notar_stammdaten.xml</code> gespeichert</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <form th:action="@{/admin/stammdaten/save}" method="post">
                    <div class="modal-body p-4">

                        <!-- Nav-Tabs -->
                        <ul class="nav nav-pills mb-4 border-bottom border-secondary pb-3 gap-2" id="stammdatenTabs" role="tablist">
                            <li class="nav-item">
                                <button class="nav-link active btn-sm" id="tab-notar" data-bs-toggle="pill" data-bs-target="#content-notar" type="button">
                                    <i class="bi bi-building me-1"></i>Kanzlei & Notar
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link btn-sm" id="tab-erbe" data-bs-toggle="pill" data-bs-target="#content-erbe" type="button">
                                    <i class="bi bi-envelope-paper me-1"></i>Brief an Erben
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link btn-sm" id="tab-erblasser" data-bs-toggle="pill" data-bs-target="#content-erblasser" type="button">
                                    <i class="bi bi-envelope-check me-1"></i>Brief an Erblasser
                                </button>
                            </li>
                            <li class="nav-item">
                                <button class="nav-link btn-sm" id="tab-verwalter" data-bs-toggle="pill" data-bs-target="#content-verwalter" type="button">
                                    <i class="bi bi-award me-1"></i>Brief an Verwalter
                                </button>
                            </li>
                        </ul>

                        <!-- Tab Inhalte -->
                        <div class="tab-content" id="stammdatenTabContent">

                            <!-- TAB 1: Kanzlei & Notar -->
                            <div class="tab-pane fade show active" id="content-notar">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small text-secondary">Kanzlei / Notariat Name</label>
                                        <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               name="kanzleiName" th:value="${notarConfig.kanzleiName}" required>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small text-secondary">Name des Notars</label>
                                        <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               name="notarName" th:value="${notarConfig.notarName}" required>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small text-secondary">Amtsbezeichnung</label>
                                        <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               name="amtsbezeichnung" th:value="${notarConfig.amtsbezeichnung}">
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label small text-secondary">DIN-5008 Absenderzeile (Rücksendezeile im Briefkopf)</label>
                                        <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               name="absenderzeile" th:value="${notarConfig.absenderzeile}" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small text-secondary">Straße & Hausnummer</label>
                                        <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               name="strasse" th:value="${notarConfig.strasse}">
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label small text-secondary">PLZ</label>
                                        <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               name="plz" th:value="${notarConfig.plz}">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small text-secondary">Ort</label>
                                        <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               name="ort" th:value="${notarConfig.ort}" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small text-secondary">Telefon</label>
                                        <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               name="telefon" th:value="${notarConfig.telefon}">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small text-secondary">E-Mail</label>
                                        <input type="email" class="form-control form-control-sm bg-dark text-white border-secondary"
                                               name="email" th:value="${notarConfig.email}">
                                    </div>
                                </div>
                            </div>

                            <!-- TAB 2: Brief an Erben -->
                            <div class="tab-pane fade" id="content-erbe">
                                <div class="mb-3">
                                    <label class="form-label small text-secondary">Betreffzeile</label>
                                    <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                           name="betreffErbe" th:value="${notarConfig.betreffErbe}">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small text-secondary">Brieftext (Erklärungsabsatz)</label>
                                    <textarea class="form-control bg-dark text-white border-secondary" rows="4"
                                              name="textErbe" th:text="${notarConfig.textErbe}"></textarea>
                                </div>
                            </div>

                            <!-- TAB 3: Brief an Erblasser -->
                            <div class="tab-pane fade" id="content-erblasser">
                                <div class="mb-3">
                                    <label class="form-label small text-secondary">Betreffzeile</label>
                                    <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                           name="betreffErblasser" th:value="${notarConfig.betreffErblasser}">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small text-secondary">Brieftext (Erklärungsabsatz)</label>
                                    <textarea class="form-control bg-dark text-white border-secondary" rows="4"
                                              name="textErblasser" th:text="${notarConfig.textErblasser}"></textarea>
                                </div>
                            </div>

                            <!-- TAB 4: Brief an Verwalter -->
                            <div class="tab-pane fade" id="content-verwalter">
                                <div class="mb-3">
                                    <label class="form-label small text-secondary">Betreffzeile</label>
                                    <input type="text" class="form-control form-control-sm bg-dark text-white border-secondary"
                                           name="betreffVerwalter" th:value="${notarConfig.betreffVerwalter}">
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small text-secondary">Brieftext (Bestallungsnachweis)</label>
                                    <textarea class="form-control bg-dark text-white border-secondary" rows="4"
                                              name="textVerwalter" th:text="${notarConfig.textVerwalter}"></textarea>
                                </div>
                            </div>

                        </div>
                    </div>

                    <div class="modal-footer border-secondary">
                        <button type="button" class="btn btn-outline-secondary btn-sm px-3" data-bs-dismiss="modal">Abbrechen</button>
                        <button type="submit" class="btn btn-warning btn-sm px-4 fw-semibold text-dark shadow">
                            <i class="bi bi-save me-1"></i>In XML speichern
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Über-Modal bleibt wie gehabt erhalten -->
    <div th:replace="~{fragments/navbar :: aboutModal}"></div>

</nav>

</body>
</html>